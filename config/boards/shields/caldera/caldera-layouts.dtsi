/*
 * Physical layout of the Caldera: where each key sits, for ZMK Studio's on-screen keyboard.
 * Units are 1/100th of a key width. Order matches the keymap (left to right, top to bottom).
 * Generated from config/caldera.json (left half x=0-500, right half x=900-1400).
 */

#include <physical_layouts.dtsi>

/ {
    caldera_layout: caldera_layout {
        compatible = "zmk,physical-layout";
        display-name = "Caldera";
        keys  //                     w   h     x    y  rot  rx  ry
            = <&key_physical_attrs 100 100     0   40    0   0   0>
            , <&key_physical_attrs 100 100   100   40    0   0   0>
            , <&key_physical_attrs 100 100   200   20    0   0   0>
            , <&key_physical_attrs 100 100   300    0    0   0   0>
            , <&key_physical_attrs 100 100   400   20    0   0   0>
            , <&key_physical_attrs 100 100   500   40    0   0   0>
            , <&key_physical_attrs 100 100   900   40    0   0   0>
            , <&key_physical_attrs 100 100  1000   20    0   0   0>
            , <&key_physical_attrs 100 100  1100    0    0   0   0>
            , <&key_physical_attrs 100 100  1200   20    0   0   0>
            , <&key_physical_attrs 100 100  1300   40    0   0   0>
            , <&key_physical_attrs 100 100  1400   40    0   0   0>

            , <&key_physical_attrs 100 100     0  140    0   0   0>
            , <&key_physical_attrs 100 100   100  140    0   0   0>
            , <&key_physical_attrs 100 100   200  120    0   0   0>
            , <&key_physical_attrs 100 100   300  100    0   0   0>
            , <&key_physical_attrs 100 100   400  120    0   0   0>
            , <&key_physical_attrs 100 100   500  140    0   0   0>
            , <&key_physical_attrs 100 100   900  140    0   0   0>
            , <&key_physical_attrs 100 100  1000  120    0   0   0>
            , <&key_physical_attrs 100 100  1100  100    0   0   0>
            , <&key_physical_attrs 100 100  1200  120    0   0   0>
            , <&key_physical_attrs 100 100  1300  140    0   0   0>
            , <&key_physical_attrs 100 100  1400  140    0   0   0>

            , <&key_physical_attrs 100 100     0  240    0   0   0>
            , <&key_physical_attrs 100 100   100  240    0   0   0>
            , <&key_physical_attrs 100 100   200  220    0   0   0>
            , <&key_physical_attrs 100 100   300  200    0   0   0>
            , <&key_physical_attrs 100 100   400  220    0   0   0>
            , <&key_physical_attrs 100 100   500  240    0   0   0>
            , <&key_physical_attrs 100 100   900  240    0   0   0>
            , <&key_physical_attrs 100 100  1000  220    0   0   0>
            , <&key_physical_attrs 100 100  1100  200    0   0   0>
            , <&key_physical_attrs 100 100  1200  220    0   0   0>
            , <&key_physical_attrs 100 100  1300  240    0   0   0>
            , <&key_physical_attrs 100 100  1400  240    0   0   0>

            , <&key_physical_attrs 100 100     0  340    0   0   0>
            , <&key_physical_attrs 100 100   100  340    0   0   0>
            , <&key_physical_attrs 100 100   200  320    0   0   0>
            , <&key_physical_attrs 100 100   300  300    0   0   0>
            , <&key_physical_attrs 100 100   400  320    0   0   0>
            , <&key_physical_attrs 100 100   500  340    0   0   0>
            , <&key_physical_attrs 100 100   900  340    0   0   0>
            , <&key_physical_attrs 100 100  1000  320    0   0   0>
            , <&key_physical_attrs 100 100  1100  300    0   0   0>
            , <&key_physical_attrs 100 100  1200  320    0   0   0>
            , <&key_physical_attrs 100 100  1300  340    0   0   0>
            , <&key_physical_attrs 100 100  1400  340    0   0   0>

            , <&key_physical_attrs 100 100     0  440    0   0   0>
            , <&key_physical_attrs 100 100   100  440    0   0   0>
            , <&key_physical_attrs 100 100   200  420    0   0   0>
            , <&key_physical_attrs 100 100   300  400    0   0   0>
            , <&key_physical_attrs 100 100   400  420    0   0   0>
            , <&key_physical_attrs 100 100   500  440    0   0   0>
            , <&key_physical_attrs 100 100   900  440    0   0   0>
            , <&key_physical_attrs 100 100  1000  420    0   0   0>
            , <&key_physical_attrs 100 100  1100  400    0   0   0>
            , <&key_physical_attrs 100 100  1200  420    0   0   0>
            , <&key_physical_attrs 100 100  1300  440    0   0   0>
            , <&key_physical_attrs 100 100  1400  440    0   0   0>
            ;
    };
};

